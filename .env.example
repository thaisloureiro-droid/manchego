# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values. Never put any of these in a Notion property.

# --- Notion ---------------------------------------------------------------
# Create an internal integration at notion.so/my-integrations, then SHARE
# Campaigns 2026 and Blockers / Dependencies with it (page menu > Connections).
# Without that share the token returns 404 on rows that plainly exist.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_CAMPAIGNS_DATA_SOURCE_ID=e2d0541e-977a-4379-82e3-c69193b36fc1
NOTION_BLOCKERS_DATA_SOURCE_ID=df6b7393-ebe3-4e23-9030-fdc93edc5ed1

# --- La Growth Machine ----------------------------------------------------
LGM_API_KEY=
LGM_API_BASE=https://apiv2.lagrowthmachine.com
# Leave false until LGM support confirms a campaign-statistics endpoint AND
# lib/lgm.js has been filled in. While false the sync refuses to run and
# raises a blocker instead of writing invented numbers.
LGM_ENDPOINTS_CONFIRMED=false

# --- Security -------------------------------------------------------------
# Vercel sends this automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Any long random string. LGM must send it as the x-webhook-secret header.
LGM_WEBHOOK_SECRET=

# --- Optional: webhook dedupe (Upstash Redis REST) ------------------------
# Without these an LGM retry will double-count an event.
DEDUPE_KV_URL=
DEDUPE_KV_TOKEN=
